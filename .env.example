# litdiscovery 环境变量模板 —— 复制为 .env 并填写真实密钥（.env 已被 gitignore，不入库）。
# 不配置的密钥对应能力将被跳过（检索/下载/验证阶段会提示缺少 token）。

# DeepSeek LLM（必配，planner/提取全链路依赖）
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# 文献检索（Apify Academic Paper Scraper）
APIFY_API_KEY=

# 联网前沿检索（Tavily MCP）
TAVILY_API_KEY=

# 全文下载
UNPAYWALL_EMAIL=
ELSEVIER_API_KEY=
SPRINGER_NATURE_API_KEY=
IEEE_API_KEY=
WILEY_API_KEY=
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=
ACADEMIC_MCP_DOWNLOAD_COMMAND=
PAPER_SEARCH_CLI_DOWNLOAD_COMMAND=

# 材料数据库验证（Materials Project）
MATERIALS_PROJECT_API_KEY=

# 产物根（可覆盖 artifacts/ 位置）
# LITDISCOVERY_ARTIFACTS=
